{
  "name": "feedcanon",
  "description": "Find the canonical URL for any web feed by comparing actual content. Turn messy feed URLs into their cleanest form.",
  "repository": {
    "type": "git",
    "url": "https://github.com/macieklamberski/feedcanon.git"
  },
  "homepage": "https://feedcanon.dev",
  "bugs": {
    "url": "https://github.com/macieklamberski/feedcanon/issues"
  },
  "license": "MIT",
  "author": "Maciej Lamberski",
  "sideEffects": false,
  "keywords": [
    "rss",
    "atom",
    "feed",
    "canonical",
    "url",
    "normalize",
    "dedupe"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/exports.d.mts",
      "default": "./dist/exports.mjs"
    },
    "./defaults": {
      "types": "./dist/defaults.d.mts",
      "default": "./dist/defaults.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown src/exports.ts src/defaults.ts --format esm --dts --clean --unbundle",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "entities": "^8.0.0"
  },
  "peerDependencies": {
    "feedsmith": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "feedsmith": "^3.0.0",
    "kvalita": "^1.22.0",
    "ogier": "^1.3.0",
    "trousse": "^2.0.0",
    "tsdown": "^0.22.14",
    "vitepress": "^2.0.0-alpha.18"
  }
}
