{
  "name": "feedcanon",
  "description": "Find the canonical URL for any web feed by comparing actual content. Turn messy feed URLs into their cleanest form.",
  "repository": {
    "type": "git",
    "url": "https://github.com/macieklamberski/feedcanon.git"
  },
  "homepage": "https://feedcanon.dev",
  "bugs": {
    "url": "https://github.com/macieklamberski/feedcanon/issues"
  },
  "license": "MIT",
  "author": "Maciej Lamberski",
  "sideEffects": false,
  "keywords": [
    "rss",
    "atom",
    "feed",
    "canonical",
    "url",
    "normalize",
    "dedupe"
  ],
  "type": "module",
  "bin": {
    "feedcanon": "bin/feedcanon.js"
  },
  "exports": {
    ".": {
      "types": "./dist/exports.d.mts",
      "default": "./dist/exports.mjs"
    },
    "./defaults": {
      "types": "./dist/defaults.d.mts",
      "default": "./dist/defaults.mjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown src/exports.ts src/defaults.ts src/cli.ts --format esm --dts --clean --unbundle",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "entities": "^8.1.0",
    "http-link-header": "^1.1.4"
  },
  "peerDependencies": {
    "feedsmith": "^3.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/http-link-header": "^1.0.7",
    "feedsmith": "^3.0.1",
    "kvalita": "^1.24.3",
    "ogier": "^1.5.0",
    "trousse": "^2.9.0",
    "tsdown": "^0.23.0",
    "vitepress": "^2.0.0-alpha.20"
  }
}
